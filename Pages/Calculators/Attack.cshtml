@page
@using MapleDreams.Models
@model MapleDreams.Pages.Calculators.AttackModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "表攻計算機";
}

@section styles {
    <style type="text/css">
        #backToTopBtn,
        #backToBottomBtn {
            position: fixed;
            right: 30px;
            z-index: 100;
            font-size: 20px;
            padding: 10px 15px;
            border: none;
            border-radius: 50%;
            background-color: #007bff;
            color: white;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0,0,0,0.3);
            display: none;
            transition: opacity 0.3s ease;
        }

        #backToTopBtn:hover,
        #backToBottomBtn:hover {
            background-color: #0056b3;
        }

        /* 位置 */
        #backToTopBtn {
            bottom: 80px;
        }

        #backToBottomBtn {
            bottom: 30px;
        }
    </style>
}

@section body_scripts {
    <script type="text/javascript">
        $(document).ready(function() {
            clearZeroInput();
            sumValue();
        });

        $('#calculator-form input[type="number"]').change(function() {
            sumValue();
        });

        $('#main-form').on('submit', function (e) {
            e.preventDefault();
            let data = generateData();
            $('#main-form input[id="Data"]').val(data);
            this.submit();
        });

        function generateData() {
            let data = '';
            $('#calculator-form input[type="number"]').each(function() {
                let name  = $(this).attr('name');
                let value = $(this).val();
                data += `${name}=${value},`;
            });
            $('#calculator-form select').each(function () {
                let name  = $(this).attr('name');
                let value = $(this).val();
                data += `${name}=${value},`;
            });
            data = data.slice(0, -1);
            return data;
        }

        function clearZeroInput() {
            $('#calculator-form input[type="number"]').each(function() {
                let name  = $(this).attr('name');
                let value = $(this).val();
                if (value == 0) {
                    $(`input[name="${name}"]`).removeAttr('value');
                    $(`input[name="${name}"]`).parent().removeClass('is-filled');
                }
            });
        }

        function sumValue() {
            // STR = Strength      力量
            // DEX = Dexterity     敏捷
            // INT = Intelligence  智力
            // LUK = Lucky         幸運
            // AD  = Attack Damage 物攻
            // AP  = Attack Power  魔攻
            let c_str = 0, c_dex = 0, c_int = 0, c_luk = 0, c_ad = 0, c_ap = 0;
            let e_str = 0, e_dex = 0, e_int = 0, e_luk = 0, e_ad = 0, e_ap = 0;
            $('#calculator-form input[type="number"]').each(function() {
                let name  = $(this).attr('name');
                let value = $(this).val();
                if (name.includes('STR')) { let chkVal = parseInt(value, 10); if (name.includes('角色基礎數值')) { c_str += !isNaN(chkVal) ? chkVal : 0; } else { e_str += !isNaN(chkVal) ? chkVal : 0; } }
                if (name.includes('DEX')) { let chkVal = parseInt(value, 10); if (name.includes('角色基礎數值')) { c_dex += !isNaN(chkVal) ? chkVal : 0; } else { e_dex += !isNaN(chkVal) ? chkVal : 0; } }
                if (name.includes('INT')) { let chkVal = parseInt(value, 10); if (name.includes('角色基礎數值')) { c_int += !isNaN(chkVal) ? chkVal : 0; } else { e_int += !isNaN(chkVal) ? chkVal : 0; } }
                if (name.includes('LUK')) { let chkVal = parseInt(value, 10); if (name.includes('角色基礎數值')) { c_luk += !isNaN(chkVal) ? chkVal : 0; } else { e_luk += !isNaN(chkVal) ? chkVal : 0; } }
                if (name.includes('AD' )) { let chkVal = parseInt(value, 10); if (name.includes('角色基礎數值')) { c_ad  += !isNaN(chkVal) ? chkVal : 0; } else { e_ad  += !isNaN(chkVal) ? chkVal : 0; } }
                if (name.includes('AP' )) { let chkVal = parseInt(value, 10); if (name.includes('角色基礎數值')) { c_ap  += !isNaN(chkVal) ? chkVal : 0; } else { e_ap  += !isNaN(chkVal) ? chkVal : 0; } }
            });
            $('li[name="sum-STR"]').text(`力：${c_str + e_str} (${c_str} + ${e_str})`);
            $('li[name="sum-DEX"]').text(`敏：${c_dex + e_dex} (${c_dex} + ${e_dex})`);
            $('li[name="sum-INT"]').text(`智：${c_int + e_int} (${c_int} + ${e_int})`);
            $('li[name="sum-LUK"]').text(`運：${c_luk + e_luk} (${c_luk} + ${e_luk})`);
            $('li[name="sum-AD"]' ).text(`AD：${e_ad}`);
            $('li[name="sum-AP"]' ).text(`AP：${e_ap}`);
        }
    </script>
    <script type="text/javascript">
        const topBtn = document.getElementById("backToTopBtn");
        const bottomBtn = document.getElementById("backToBottomBtn");

        function updateButtonVisibility() {
            const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
            const scrollHeight = document.documentElement.scrollHeight || document.body.scrollHeight;
            const clientHeight = document.documentElement.clientHeight || window.innerHeight;

            const atTop = scrollTop === 0;
            const atBottom = scrollTop + clientHeight >= scrollHeight - 1; // 容許 1px 容差

            topBtn.style.display = atTop ? "none" : "block";
            bottomBtn.style.display = atBottom ? "none" : "block";
        }

        window.addEventListener("scroll", updateButtonVisibility);
        window.addEventListener("load", updateButtonVisibility);

        topBtn.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        bottomBtn.addEventListener("click", () => {
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        });
    </script>
}

<div class="container" id="calculator-form">
    <div asp-validation-summary="All" class="my-3"></div>
    @{
        List<string> attrENG = new List<string> { "STR", "DEX", "INT", "LUK", "AD", "AP" };
        List<string> attrCHT = new List<string> { "力", "敏", "智", "幸", "AD", "AP" };
    }
    <div class="row">
        <div class="col-12">
            <div class="card my-3">
                <h5 class="mb-0 alert-warning">
                    <button class="btn btn-link" data-toggle="collapse" data-target="#attention-collapse" aria-expanded="true">
                        <b>使用說明 [+]</b>
                    </button>
                </h5>
                <div id="attention-collapse" class="collapse">
                    <div class="card-body">
                        <p>
                            簡單介紹幾個比較實用的功能：
                        </p>
                        <ol>
                            <li>
                                <b>網址分享：</b>
                                <span>在計算後可以複製網址分享給別人，當別人打開同樣的網址就可以看到同樣的設定，但需要注意的是別人也一樣可以編輯，所以建議如果是自己要做紀錄用，在計算完後要記得匯出。</span>
                            </li>
                            <li>
                                <b>紀錄匯出／匯入：</b>
                                <span>可以將現有的設定紀錄匯出或匯入，請注意在匯出之前一定要先計算過，匯出的紀錄是最後一次計算的設定和結果。</span>
                            </li>
                            <li>
                                <b>摺疊項目：</b>
                                <span>如果覺得卡片太大有點礙眼，可以按一下卡片標題來讓他先折起來。</span>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card my-3">
                <h5 class="mb-0 alert-dark">
                    <button class="btn btn-link" data-toggle="collapse" data-target="#rwfile-collapse" aria-expanded="true">
                        記錄匯入／匯出
                    </button>
                </h5>
                <div id="rwfile-collapse" class="collapse">
                    <div class="card-body">
                    <div class="row">
                        <div class="col-12">
                            <h6>匯入紀錄</h6>
                            <form method="post" enctype="multipart/form-data" asp-page-handler="Upload">
                                <input type="file" class="btn btn-secondary" name="UploadedFile" />
                                <input type="submit" class="btn btn-primary" value="上傳" />
                            </form>
                        </div>
                        <div class="col-12"><hr /></div>
                        <div class="col-12">
                            <h6>匯出紀錄</h6>
                            <form method="post" asp-page-handler="Download">
                                <input asp-for="PageId" type="hidden" />
                                <input type="submit" class="btn btn-primary" onclick="generateData()" value="下載" />
                            </form>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card my-3">
                <h5 class="mb-0 alert-info">
                    <button class="btn btn-link" data-toggle="collapse" data-target="#attack-result-collapse" aria-expanded="true">
                        表功計算結果
                    </button>
                </h5>
                <div id="attack-result-collapse" class="collapse show">
                    <div class="card-body">
                        <h6>表功範圍：@(Model.MinAttack.ToString("0.00")) ~ @(Model.MaxAttack.ToString("0.00"))</h6>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 mt-3"></div>
        <div class="col-12">
            <div class="card">
                <h5 class="mb-0 alert-primary">
                    <button class="btn btn-link" data-toggle="collapse" data-target="#extend-collapse" aria-expanded="true">
                        人物與武器設定
                    </button>
                </h5>
                <div class="card-body collapse show" id="extend-collapse">
                    <form method="post" class="container" id="main-form">
                        <div class="row">
                            @foreach (var i in Enum.GetValues(typeof(CharacterExtendType)))
                            {
                                string key = i.ToString();
                                <div class="col-12">
                                    <h5>@key</h5>
                                </div>
                                    @for (int attr_i = 0; attr_i < attrENG.Count; attr_i++)
                                    {
                                        string elemName = $"{key}-{attrENG[attr_i]}";
                                        string textName = attrCHT[attr_i];
                                        <div class="form-group col-2">
                                            <label class="bmd-label-floating" for="@elemName">@textName</label>
                                            <input type="number" class="form-control" name="@elemName" min="0" max="9999" value="@(Model.AttackCalculator.Keys.Any(x => x == key) ? Model.AttackCalculator.Equipments[key].GetValue(attrENG[attr_i]) : "")" />
                                        </div>
                                    }
                                <div class="col-12">
                                    <hr />
                                </div>
                            }
                            <div class="col-12">
                                <label class="bmd-label-floating" for="武器熟練度">武器熟練度 (%)</label>
                                <input asp-for="WeaponProficiency" type="number" class="form-control" min="0" maxn="9999" />
                            </div>
                            <div class="col-12">
                                <hr />
                            </div>
                            <div class="col-12">
                                <label class="bmd-label-floating" for="武器類型">武器類型</label>
                                <select asp-for="WeaponSelect" asp-items="@Model.WeaponType" class="form-control"></select>
                            </div>
                            <div class="col-12">
                                <hr />
                            </div>
                            <div class="col-12">
                                <h6>總數值</h6>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item" name="sum-STR">力：0</li>
                                    <li class="list-group-item" name="sum-DEX">敏：0</li>
                                    <li class="list-group-item" name="sum-INT">智：0</li>
                                    <li class="list-group-item" name="sum-LUK">運：0</li>
                                    <li class="list-group-item" name="sum-AD">AD：0</li>
                                    <li class="list-group-item" name="sum-AP">AP：0</li>
                                </ul>
                            </div>
                        </div>
                        <div class="text-right">
                            <input asp-for="Data" type="hidden" />
                            <input asp-for="PageId" type="hidden" />
                            <input type="submit" class="btn btn-primary" value="計算" />
                        </div>
                    </form>                    
                </div>
            </div>
        </div>
        <div class="col-12 mt-3"></div>
        @foreach (var i in Enum.GetValues(typeof(EquipmentType)))
        {
            string cardType = "info";
            switch (i)
            {
                case EquipmentType.一般:
                    cardType = "primary";
                    break;
                case EquipmentType.時裝:
                    cardType = "primary";
                    break;
            }
            <div class="col-md-6">
                <div class="card border-@(cardType)">
                    <h5 class="mb-0 alert-@cardType">
                        <button class="btn btn-link" data-toggle="collapse" data-target="#@(i.ToString())-main-collapse" aria-expanded="true">
                            @(i.ToString())
                        </button>
                    </h5>
                        <div class="card-body collapse show" id="@(i.ToString())-main-collapse">
                        <div class="row">
                            @{
                                @for (int j = 0; j < Model.AttackCalculator.Keys.Count;)
                                {
                                    
                                    string mainKey = Model.AttackCalculator.Keys[j];

                                    if (mainKey.Count(x => x == '_') < 2)
                                    {
                                        j++;
                                        continue;
                                    }

                                    string mainType = mainKey.Split("_")[0];
                                    string mainCategory = mainKey.Split("_")[1];

                                    if (mainType != i.ToString())
                                    {
                                        j++;
                                        continue;
                                    }
                                    else
                                    {
                                        <div class="col-12">
                                            <div class="card">
                                                <h5 class="mb-0 alert-secondary">
                                                    <button class="btn btn-link" data-toggle="collapse" data-target="#@mainKey.Split("_")[1]-collapse" aria-expanded="true">
                                                        @mainKey.Split("_")[1]
                                                    </button>
                                                </h5>
                                                <div class="card-body collapse show" id="@mainKey.Split("_")[1]-collapse">
                                                    @for (int k = j; k < Model.AttackCalculator.Keys.Count; k++)
                                                    {
                                                        string key = Model.AttackCalculator.Keys[k];
                                                        string type = key.Split("_")[1];
                                                        string category = key.Split("_")[2];

                                                        <div class="row">
                                                            <div class="col-12">
                                                                <h6>@category</h6>
                                                            </div>
                                                            @for (int attr_i = 0; attr_i < attrENG.Count; attr_i++)
                                                            {
                                                                string elemName = $"{key}-{attrENG[attr_i]}";
                                                                string textName = attrCHT[attr_i];
                                                                <div class="form-group col-2">
                                                                    <label class="bmd-label-floating" for="@elemName">@textName</label>
                                                                    <input type="number" class="form-control" name="@elemName" min="0" max="9999" value="@(Model.AttackCalculator.Keys.Any(x => x == key) ? Model.AttackCalculator.Equipments[key].GetValue(attrENG[attr_i]) : "")" />
                                                                </div>
                                                            }
                                                        </div>

                                                        if (((k + 1) >= Model.AttackCalculator.Keys.Count) || (Model.AttackCalculator.Keys[k + 1].Count(x => x == '_') < 2) || Model.AttackCalculator.Keys[k + 1].Split("_")[1] != mainCategory)
                                                        {
                                                            j = k + 1;
                                                            break;
                                                        }
                                                        else
                                                        {
                                                            <div class="col-12">
                                                                <hr />
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 mt-3"></div>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="d-md-none col-12 mt-3"></div>
        <div class="d-md-block col-12 mt-3"></div>
        <div class="col-12">
            <div class="card">
                <h5 class="mb-0 alert-primary">
                    <button class="btn btn-link" data-toggle="collapse" data-target="#extend-collapse" aria-expanded="true">
                        套裝效果
                    </button>
                </h5>
                <div class="card-body collapse show" id="extend-collapse">
                    <div class="row">
                        @foreach (var i in Enum.GetValues(typeof(EquipmentExtendType)))
                        {
                            string key = i.ToString();
                            <div class="col-12">
                                <h6>@key</h6>
                            </div>
                                @for (int attr_i = 0; attr_i < attrENG.Count; attr_i++)
                                {
                                    string elemName = $"{key}-{attrENG[attr_i]}";
                                    string textName = attrCHT[attr_i];
                                    <div class="form-group col-2">
                                        <label class="bmd-label-floating" for="@elemName">@textName</label>
                                        <input type="number" class="form-control" name="@elemName" min="0" max="9999" value="@(Model.AttackCalculator.Keys.Any(x => x == key) ? Model.AttackCalculator.Equipments[key].GetValue(attrENG[attr_i]) : "")" />
                                    </div>
                                }
                            <div class="col-12">
                                <hr />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="d-md-block col-12 mt-3"></div>
        <div class="col-12">
            <div class="card">
                <h5 class="mb-0 alert-primary">
                    <button class="btn btn-link" data-toggle="collapse" data-target="#extend-collapse" aria-expanded="true">
                        技能或其他增益
                    </button>
                </h5>
                <div class="card-body collapse show" id="extend-collapse">
                    <div class="row">
                        @foreach (var i in Enum.GetValues(typeof(SkillExtendType)))
                        {
                            string key = i.ToString();
                            <div class="col-12">
                                <h6>@key</h6>
                            </div>
                                @for (int attr_i = 0; attr_i < attrENG.Count; attr_i++)
                                {
                                    string elemName = $"{key}-{attrENG[attr_i]}";
                                    string textName = attrCHT[attr_i];
                                    if (key == "楓葉祝福")
                                    {
                                        <div class="form-group col-12">
                                            <label class="bmd-label-floating" for="MapleWarriorLevel">等級</label>
                                            <input asp-for="MapleWarriorLevel" type="number" class="form-control" min="0" max="40" />
                                        </div>
                                        break;
                                    }
                                    else
                                    {
                                        <div class="form-group col-2">
                                            <label class="bmd-label-floating" for="@elemName">@textName</label>
                                            <input type="number" class="form-control" name="@elemName" min="0" max="9999" value="@(Model.AttackCalculator.Keys.Any(x=> x == key) ? Model.AttackCalculator.Equipments[key].GetValue(attrENG[attr_i]) : "")" />
                                        </div>
                                    }
                                }
                            <div class="col-12">
                                <hr />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 回到最上 -->
<button id="backToTopBtn" title="回到最上">↑</button>
<!-- 回到底部 -->
<button id="backToBottomBtn" title="回到底部">↓</button>