@page
@model MapleDreams.Pages.Drops.CatalystStoneModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "催化劑、礦石掉落查詢";
}

@section body_scripts {
    <script type="text/javascript">
        const checkBoxsGroupControl = function (keyword) {
            let checkBoxs;
            let keyword1 = `${keyword}s`
            let keyword2 = `Enable${keyword}`;

            checkBoxs = document.getElementsByName(keyword1);
            for (let i = 0; i < checkBoxs.length; i++) {
                checkBoxs[i].disabled = !document.getElementsByName(keyword2)[0].checked;
            }
            checkBoxs = document.getElementsByName(keyword1);
            for (let i = 0; i < checkBoxs.length; i++) {
                checkBoxs[i].disabled = !document.getElementsByName(keyword2)[0].checked;
            }
        };
    </script>
}

<div class="container">
    <div asp-validation-summary="All" class="my-3"></div>
    <div class="card my-3">
        <h5 class="mb-0">
            <button class="btn btn-link" data-toggle="collapse" data-target="#search-collapse">
                條件搜尋
            </button>
        </h5>
        <div id="search-collapse" class="collapse">
            <div class="card-body">
                <div class="form-horizontal">
                    <form method="get">
                        <div class="form-group">
                            <label for="Name" class="bmd-label-floating">怪物名稱</label>
                            <input asp-for="Name" type="text" class="form-control" />
                        </div>
                        <div>
                            <label class="bmd-label-static">催化劑</label>
                            <div>
                                <label class="checkbox-inline">
                                    <input type="checkbox" name="EnableCatalyst" value="true" onclick="checkBoxsGroupControl('Catalyst')" @(Model.EnableCatalyst ? "checked" : "") />啟用催化劑篩選
                                </label>
                                <br />
                                @foreach (string catalysts in Model.CatalystItems)
                                {
                                    <label class="checkbox-inline">
                                        <input type="checkbox" name="Catalysts" value="@catalysts"
                                            @((Model.Click == 0) ? "" : (Model.Catalysts.Contains(catalysts) ? "checked" : ""))
                                            @(Model.EnableCatalyst ? "" : "disabled='true''") />
                                            @catalysts.PadRight(3, '　')
                                    </label>
                                }
                            </div>
                        </div>
                        <div>
                            <label class="bmd-label-static">母礦</label>
                            <div>
                                <label class="checkbox-inline">
                                    <input type="checkbox" name="EnableStone" value="true" onclick="checkBoxsGroupControl('Stone')" @(Model.EnableStone ? "checked" : "") />啟用母礦篩選
                                </label>
                                <br />
                                @foreach (string stone in Model.StoneItems)
                                {
                                    <label class="checkbox-inline">
                                        <input type="checkbox" name="Stones" value="@stone"
                                            @((Model.Click == 0) ? "" : (Model.Stones.Contains(stone) ? "checked" : ""))
                                            @(Model.EnableStone ? "" : "disabled='true'")/>
                                            @stone.PadRight(3, '　')
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="text-right">
                            <input type="hidden" name="click" value="1" />
                            <input type="submit" class="btn btn-primary" value="搜尋" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container">
    <div class="text-right">
        <small>
            <span style="color: red;">資料來源：夢時代圖書館 - <a href="https://discord.com/channels/1023305944010063882/1023774346117926922">各種催化劑掉落</a>、<a href="https://discord.com/channels/1023305944010063882/1024393362620559421">礦石掉落查詢</a></span>
        </small>
    </div>
    <table class="table table-bordered table-striped">
        <thead>
            <tr class="table-info text-center">
                <th style="width: 33.4%;">名稱</th>
                <th style="width: 33.3%;">催化劑</th>
                <th style="width: 33.3%;">母礦</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var monster in Model.Monsters)
            {
                <tr>
                    <td class="text-center">@monster.Name</td>
                    <td class="text-left">@monster.Catalyst</td>
                    <td class="text-left">@monster.Stone</td>
                </tr>
            }
        </tbody>
    </table>
</div>