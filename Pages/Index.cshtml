    <hr />
    <h1 class="my-3">近期更新<a asp-page="/UpdatedLogs" style="font-size: 1rem;"><i class="fas fa-list-alt fa-fw"></i></a></h1>
    <table class="table table-striped">
        <thead>
            <tr class="table-info text-center">
                <th class="td-col-1">#</th>
                <th class="td-col-1">日期</th>
                <th class="td-col-8 text-left">內容</th>
            </tr>
        </thead>
        <tbody>
            @{
                var updatedLogList = new MapleDreams.Pages.UpdatedLogsModel().UpdatedLogList;
                int i = updatedLogList.Count;
                foreach (var key in updatedLogList.Keys.OrderByDescending(key => key.Ticks))
                {
                    var logItem = updatedLogList[key];
                        <tr class="text-center">
                            <td>@(i--)</td>
                            <td>@(key.ToString("yyyy-MM-dd"))</td>
                            <td class="text-left">
                                @for (int j = 0; j < logItem.Count; j++)
                                {
                                    @Html.Raw(logItem[j]);
                                    if (j != logItem.Count - 1)
                                    {
                                        <br />
                                    }
                                }
                            </td>
                        </tr>
                    if (updatedLogList.Count - i >= 3)
                    {
                        break;
                    }
                }
            }
        </tbody>
    </table>
    <hr />
