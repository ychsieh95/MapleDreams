{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "provider": "unpkg",
      "library": "font-awesome-5-css@5.4.1",
      "destination": "wwwroot/lib/font-awesome"
    },
    {
      "provider": "unpkg",
      "library": "bootstrap-material-design@4.1.3",
      "destination": "wwwroot/lib/bootstrap-material-design"
    },
    {
      "library": "jquery@3.3.1",
      "files": [ "jquery.min.js" ],
      "destination": "wwwroot/lib/jquery"
    },
    {
      "library": "popper.js@1.12.6",
      "destination": "wwwroot/lib/popper.js"
    }
  ]
}